# --- Application Server ---
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
MAX_BATCH_SIZE=100
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RUN_MIGRATIONS=false

# --- PostgreSQL / Supabase Database Configuration ---
# Direct / Pooler URI for Supabase or local PostgreSQL:
# postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.mxiyhuombyyfjytvwfgk.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/iot_security
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30.0

# --- Supabase Credentials ---
SUPABASE_URL=https://mxiyhuombyyfjytvwfgk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_cfOqulwUs8J412rjvtIlJw_0bZwUX_s

# --- Threat Detection Models ---
DEFAULT_DETECTOR=random_forest
MODELS_DIR=models

# --- Groq LLM Configuration ---
# Supported models on user tier: openai/gpt-oss-20b, qwen/qwen3.8-27b, openai/gpt-oss-120b
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_OUTPUT_TOKENS=1024

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000
